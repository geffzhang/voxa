<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Voxa.ArkeSidecar</AssemblyName>
    <RootNamespace>Voxa.ArkeSidecar</RootNamespace>
    <Version>0.8.0-alpha</Version>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Voxa.ArkeSidecar.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <ProjectReference Include="..\Voxa.Speech.Kokoro\Voxa.Speech.Kokoro.csproj" />
    <ProjectReference Include="..\Voxa.Speech.WhisperCpp\Voxa.Speech.WhisperCpp.csproj" />
  </ItemGroup>

</Project>
